<% const title = 'Player Positions — ' + team.name; %>
<%- include('layout') %>

<a href="/admin/teams/<%= team.slug %>" class="back-link">← Back to <%= team.name %></a>
<h1>Player Positions</h1>

<% if (saved) { %>
  <div class="success-msg">Positions saved.</div>
<% } %>

<% if (players.length === 0) { %>
  <p class="muted">No players on the roster yet. Add players on the team page first.</p>
<% } else { %>
<form method="POST" action="/admin/teams/<%= team.slug %>/positions">
  <div class="card">
    <h2>Field Format</h2>
    <p class="muted" style="margin-bottom:0.75rem">The default field shown on the public team page. Visitors can switch between both formats.</p>
    <div style="display:flex;gap:1.25rem;flex-wrap:wrap">
      <% for (const f of [4, 7]) { %>
        <% const fm = formations[f]; %>
        <label style="display:flex;align-items:center;gap:0.4rem;cursor:pointer">
          <input type="radio" name="field_format" value="<%= f %>" <%= (team.field_format || 7) == f ? 'checked' : '' %>>
          <strong><%= f %> Players</strong>
          <span class="muted">(<%= Object.keys(fm).map(k => fm[k] + ' ' + positionAbbr[k]).join(' · ') %>)</span>
        </label>
      <% } %>
    </div>
  </div>

  <div class="card">
    <h2>Positions</h2>
    <table class="positions-table">
      <thead>
        <tr><th>Player</th><th>Primary</th><th>Secondary</th></tr>
      </thead>
      <tbody>
        <% for (const player of players) { %>
          <tr>
            <td><%= player.player_name %></td>
            <td>
              <select name="primary_<%= player.id %>">
                <option value="">—</option>
                <% for (const pos of positions) { %>
                  <option value="<%= pos.key %>" <%= player.primary_position === pos.key ? 'selected' : '' %>><%= pos.label %></option>
                <% } %>
              </select>
            </td>
            <td>
              <select name="secondary_<%= player.id %>">
                <option value="">—</option>
                <% for (const pos of positions) { %>
                  <option value="<%= pos.key %>" <%= player.secondary_position === pos.key ? 'selected' : '' %>><%= pos.label %></option>
                <% } %>
              </select>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
    <p class="muted" style="margin:0.75rem 0;font-size:0.85rem">A secondary position matching the primary is cleared on save.</p>
    <div style="display:flex;gap:0.5rem;flex-wrap:wrap">
      <button type="submit" class="btn btn-primary">Save Positions</button>
      <a href="/team/<%= team.slug %>#positions" target="_blank" class="btn btn-outline">View Public Field</a>
    </div>
  </div>
</form>
<% } %>

<%- include('footer') %>
