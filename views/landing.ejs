<% const title = 'Home'; %>
<%- include('layout') %>

<div class="landing">
  <h1 class="text-center">Snack Signup</h1>
  <p class="text-center landing-subtitle">The easy way to organize game-day snacks for your team.</p>

  <% if (poll) { %>
  <div class="card" style="text-align:center;border:2px solid #2d6a4f">
    <h2 style="margin-bottom:0.5rem"><%= poll.title %></h2>
    <p class="muted" style="margin-bottom:1rem">Cast your vote for the team name!</p>
    <a href="/vote" class="btn btn-primary">Vote Now</a>
  </div>
  <% } %>

  <div class="card landing-card">
    <h2>How It Works</h2>
    <ol class="landing-steps">
      <li>Your team manager creates a schedule with all the games for the season.</li>
      <li>Parents visit the team page and sign up to bring snacks to a game.</li>
      <li>Everyone knows who's bringing snacks &mdash; no more group texts or spreadsheets.</li>
    </ol>
  </div>

</div>

<%- include('footer') %>
